          },
          "schedule_status": "scheduled",
          "duration_minutes": 30,
          "start_at": "2026-10-22T09:00:00+08:00",
          "end_at": "2026-10-22T09:30:00+08:00",
          "completed": false,
          "reason": "现场与天气均已确认；按用户期限、优先级和任务编号排入最早时段",
          "reason_code": "scheduled",
          "missing_fields": [],
          "evidence": [
            {
              "rule_id": "C31",
              "title": "普通巡田的苗情墒情虫情记录",
              "pack_version": "融合修订版1.0",
              "evidence_version": "2026-10-17",
              "source_id": "Z16",
              "source_title": "农业农村部办公厅关于大力开发冬闲田积极扩种冬油菜的通知",
              "publisher": "农业农村部办公厅；种植业管理司网站发布",
              "source_date": "2020-11-24（网页）；2020-11-05（文件落款）",
              "source_url": "https://zzys.moa.gov.cn/gzdt/202011/t20201124_6356875.htm",
              "pdf_pages": [
                1
              ],
              "quote": "组织专家和农技人员深入一线，开展查苗情、查墒情、查虫情，推进油菜生产关键技术措施落实。",
              "applicability_text": "2020年扩种冬油菜通知；借鉴为湖北已确认苗期的小型田块巡田清单，属于项目设计。",
              "condition_text": "用户有检查需求，或其他卡片提出检查候选；不要求检查前已经知道目标农情。",
              "limits": "不推出固定频率、标准工时或病害诊断；普通巡田不等于C04专业监测。",
              "source_sha256": "b5e850077800773f4c2a8f827ac0af198c5e7cc7e0cd3bbf422cec6da64e601e",
              "runtime_enabled": false,
              "status_label": "开发验证，适用性待复核"
            },
            {
              "rule_id": "C11",
              "title": "巡田记录缺苗和拥挤现象",
              "pack_version": "融合修订版1.0",
              "evidence_version": "2026-10-17",
              "source_id": "Z15",
              "source_title": "2025年湖北省油菜苗期田间管理技术指导意见",
              "publisher": "湖北省油菜办公室",
              "source_date": "2025-11-07",
              "source_url": "https://nyt.hubei.gov.cn/bmdt/yw/ywtz/sycbgs_9005/202511/t20251107_5807293.shtml",
              "pdf_pages": [
                1
              ],
              "quote": "在油菜3-5叶期，采取人工或机械中耕等方式及时清理窝堆苗、拥挤苗，去密留稀、去弱留壮、移密补稀，做到叶不搭叶。",
              "applicability_text": "2025年湖北苗期指导；当前湖北苗期巡田借鉴观察项。",
              "condition_text": "已确认苗期且存在检查需求；3～5叶是原文处置阶段，不是巡田门槛。",
              "limits": "Z09另述冬前先间苗再追肥化调；两文条件不能无说明拼接成统一硬约束。",
              "source_sha256": "06e6278356917900f1c0d4be755dcf763a00355d53fefa2cb382adaa32193f71",
              "runtime_enabled": false,
              "status_label": "开发验证，适用性待复核"
            },
            {
              "rule_id": "C11",
              "title": "巡田记录缺苗和拥挤现象",
              "pack_version": "融合修订版1.0",
              "evidence_version": "2026-10-17",
              "source_id": "Z09",
              "source_title": "湖北省油菜冬前田间管理技术指导意见",
              "publisher": "湖北省油菜办公室、湖北省油菜大面积单产提升专家指导组",
              "source_date": "2025-12-03",
              "source_url": "https://nyt.hubei.gov.cn/bmdt/yw/ywtz/sycbgs_9005/202512/t20251203_5825918.shtml",
              "pdf_pages": [
                2
              ],
              "quote": "在追肥、化调等田管措施之前采取人工或机械中耕等方式及时间苗",
              "applicability_text": "2025年湖北苗期指导；当前湖北苗期巡田借鉴观察项。",
              "condition_text": "已确认苗期且存在检查需求；3～5叶是原文处置阶段，不是巡田门槛。",
              "limits": "Z09另述冬前先间苗再追肥化调；两文条件不能无说明拼接成统一硬约束。",
              "source_sha256": "1d51f472885ce30219e48011f13eb539fce5599cd1edba31529fe36801040dca",
              "runtime_enabled": false,
              "status_label": "开发验证，适用性待复核"
            },
            {
              "rule_id": "C19",
              "title": "低洼田积水检查与维护反馈",
              "pack_version": "融合修订版1.0",
              "evidence_version": "2026-10-17",
              "source_id": "Z09",
              "source_title": "湖北省油菜冬前田间管理技术指导意见",
              "publisher": "湖北省油菜办公室、湖北省油菜大面积单产提升专家指导组",
              "source_date": "2025-12-03",
              "source_url": "https://nyt.hubei.gov.cn/bmdt/yw/ywtz/sycbgs_9005/202512/t20251203_5825918.shtml",
              "pdf_pages": [
                1
              ],
              "quote": "稻茬田、低洼田、冷浸田要保证厢宽2米以内，并每30米加开腰沟，做到雨止田干、沟无积水。",
              "applicability_text": "2025年湖北冬前稻茬田、低洼田或冷浸田。",
              "condition_text": "相关田型已确认，存在检查需求或维护后反馈。",
              "limits": "不自动新开腰沟；田型标签可重叠，遇丘陵易旱情境与C20一并核实目标。",
              "source_sha256": "1d51f472885ce30219e48011f13eb539fce5599cd1edba31529fe36801040dca",
              "runtime_enabled": false,
              "status_label": "开发验证，适用性待复核"
            }
          ]
        },
        {
          "task_id": "field-f10f75827f-M",
          "plot_id": "field-f10f75827f",
          "title": "既有沟渠维护候选",
          "task_type": "maintenance",
          "applicability": "matched",
          "necessity": "unknown",
          "window_by_date": {},
          "schedule_status": "pending",
          "duration_minutes": null,
