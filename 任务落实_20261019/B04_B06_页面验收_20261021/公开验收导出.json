        {
          "task_id": "field-f10f75827f-I",
          "plot_id": "field-f10f75827f",
          "title": "巡田苗情墒情虫情与沟渠检查",
          "task_type": "inspection",
          "applicability": "matched",
          "necessity": "required",
          "window_by_date": {
