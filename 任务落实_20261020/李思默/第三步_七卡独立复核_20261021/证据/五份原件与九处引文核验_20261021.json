      ],
      "locator": "三 间密补稀 优化群体",
      "quote": "在追肥、化调等田管措施之前采取人工或机械中耕等方式及时间苗",
      "quote_found_after_nfkc_whitespace_only": true,
      "card_hash_matches": true
    },
    {
